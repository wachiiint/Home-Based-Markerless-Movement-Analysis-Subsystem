SERVICE_API_KEY=dev-local-analysis-key
DEVICE=auto
MODEL_BACKEND=rtmlib
POSE_MODEL=rtmpose-m
RTMLIB_MODE=balanced
FRAME_SAMPLE_FPS=10
MIN_KEYPOINT_CONFIDENCE=0.4
MIN_VALID_FRAME_RATIO=0.6
SMOOTHING_ALPHA=0.4
ENABLE_3D=false
MOTIONBERT_MODEL_PATH=models/target/motionbert_lite_sim.onnx
FAKE_MODE=false
DEMO_MAX_UPLOAD_MB=100
SESSION_DATA_DIR=data/sessions
# 0 = stored analyses are never deleted (proof-of-concept default).
DEMO_RESULT_TTL_SECONDS=0
# Set to false before storing real patient recordings: metrics and keypoints are
# kept, the annotated footage is not. The uploaded clip is never stored either way.
KEEP_ANNOTATED_VIDEO=true
# How far apart the left-leg and right-leg clips of one asymmetry comparison may
# be recorded before /compare flags the pair. A warning, not a refusal -- the
# clinically defensible limit is still an open question.
ASYMMETRY_MAX_DAYS_APART=30
LOG_LEVEL=INFO
