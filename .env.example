SERVICE_API_KEY=dev-local-analysis-key
DEVICE=auto
MODEL_BACKEND=rtmlib
POSE_MODEL=rtmpose-m
RTMLIB_MODE=balanced
FRAME_SAMPLE_FPS=10
MIN_KEYPOINT_CONFIDENCE=0.4
MIN_VALID_FRAME_RATIO=0.6
SMOOTHING_ALPHA=0.4
ENABLE_3D=false
MOTIONBERT_MODEL_PATH=models/target/motionbert_lite_sim.onnx
STORE_TEMP_FILES=false
FAKE_MODE=false
DEMO_MAX_UPLOAD_MB=100
DEMO_MAX_DURATION_SECONDS=120
DEMO_RESULT_TTL_SECONDS=3600
LOG_LEVEL=INFO
